{
  "name": "js-cold-chain",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" }
    ]
  },
  "pipelines": [
    { "binding": "STREAM", "stream": "events" }
  ],
  "services": [
    { "binding": "PIPELINE", "service": "orders" },
    { "binding": "SINK_A", "service": "primary_sink" },
    { "binding": "CATALOG", "service": "warehouse" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] }
  ]
}
