# name: test/sql/verglas.test
# description: the loadable artifact registers the complete relational surface
# group: [verglas]

require verglas

query I
SELECT count(*)
FROM duckdb_functions()
WHERE function_name IN (
  'verglas_query',
  'verglas_graph_neighbors',
  'verglas_graph_k_hop',
  'verglas_graph_paths',
  'verglas_vector_search'
);
----
5
