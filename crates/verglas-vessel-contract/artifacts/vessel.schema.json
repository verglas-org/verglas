{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VesselManifest",
  "description": "A versioned composition of Integrations, Workers, and one Interface.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "description": "Contract API version. Must be `verglas.io/v1alpha1`.",
      "type": "string"
    },
    "integrations": {
      "description": "External API components available to Workers and the Interface.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/IntegrationComponent"
      }
    },
    "interface": {
      "description": "The Vessel's sole graphical application component.",
      "$ref": "#/$defs/InterfaceComponent"
    },
    "kind": {
      "description": "Manifest kind. Must be `Vessel`.",
      "type": "string"
    },
    "name": {
      "description": "Stable Vessel name.",
      "type": "string"
    },
    "version": {
      "description": "Immutable source release version of this composition.",
      "type": "string"
    },
    "workers": {
      "description": "Data and agentic operations materialized as Jobs at runtime.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkerComponent"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "version",
    "interface"
  ],
  "$defs": {
    "ComponentGrants": {
      "description": "Scoped capabilities supplied to a Worker Job or Interface.",
      "type": "object",
      "properties": {
        "graphs": {
          "description": "Graph read and write grants.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DataGrant"
          }
        },
        "integrations": {
          "description": "Integration API components exposed through the reflected SDK.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "tables": {
          "description": "Table read and write grants.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DataGrant"
          }
        },
        "vectors": {
          "description": "Vector-index read and write grants.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DataGrant"
          }
        }
      },
      "additionalProperties": false
    },
    "ConfigurationField": {
      "description": "One Integration configuration input definition, never its runtime value.",
      "type": "object",
      "properties": {
        "default": {
          "description": "Optional non-secret initial value."
        },
        "help": {
          "description": "Concise field-level setup help.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Human-readable form label.",
          "type": "string"
        },
        "name": {
          "description": "Environment-style identifier exposed to the Integration process.",
          "type": "string"
        },
        "placeholder": {
          "description": "Non-sensitive example shown when the field is empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Whether the Integration may start without a value.",
          "type": "boolean",
          "default": false
        },
        "type": {
          "description": "Input and storage behavior.",
          "$ref": "#/$defs/ConfigurationFieldType"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type"
      ]
    },
    "ConfigurationFieldType": {
      "description": "Supported Integration configuration input behaviors.",
      "oneOf": [
        {
          "description": "Ordinary UTF-8 text.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "A credential stored and rendered as a secret.",
          "type": "string",
          "const": "secret"
        },
        {
          "description": "An HTTP or HTTPS URL.",
          "type": "string",
          "const": "url"
        },
        {
          "description": "A numeric value.",
          "type": "string",
          "const": "number"
        },
        {
          "description": "A true or false value.",
          "type": "string",
          "const": "boolean"
        }
      ]
    },
    "ConfigurationStep": {
      "description": "One ordered instruction in an Integration setup guide.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Instructions the user can follow without outside context.",
          "type": "string"
        },
        "title": {
          "description": "Short action-oriented heading.",
          "type": "string"
        },
        "url": {
          "description": "Optional HTTPS documentation or provider-console link.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ]
    },
    "CronTrigger": {
      "description": "Cron trigger configuration.",
      "type": "object",
      "properties": {
        "cron": {
          "description": "Five-field UTC cron expression.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "cron"
      ]
    },
    "DataGrant": {
      "description": "One read or write grant for a named lakehouse resource.",
      "anyOf": [
        {
          "description": "Read a named resource.",
          "$ref": "#/$defs/ReadGrant"
        },
        {
          "description": "Write a named resource.",
          "$ref": "#/$defs/WriteGrant"
        }
      ]
    },
    "EventTrigger": {
      "description": "CloudEvents trigger configuration.",
      "type": "object",
      "properties": {
        "event": {
          "description": "Exact CloudEvents `type` value.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "event"
      ]
    },
    "IntegrationComponent": {
      "description": "One independently versioned external API component.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Configuration UI and credential requirements owned by this Integration.",
          "$ref": "#/$defs/IntegrationConfiguration"
        },
        "name": {
          "description": "Name used by grants and the reflected Verglas SDK namespace.",
          "type": "string"
        },
        "project": {
          "description": "Relative directory containing the component project.",
          "type": "string"
        },
        "version": {
          "description": "Independent source version pinned by the containing Vessel release.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "project",
        "config"
      ]
    },
    "IntegrationConfiguration": {
      "description": "Declarative configuration screen supplied by an Integration.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "Values the user must or may configure at runtime.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ConfigurationField"
          }
        },
        "setup": {
          "description": "Ordered provider setup guidance displayed alongside the fields.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ConfigurationStep"
          }
        }
      },
      "additionalProperties": false
    },
    "InterfaceComponent": {
      "description": "One independently versioned graphical application component.",
      "type": "object",
      "properties": {
        "grants": {
          "description": "Lakehouse and Integration capabilities granted to the Interface.",
          "$ref": "#/$defs/ComponentGrants",
          "default": {
            "graphs": [],
            "integrations": [],
            "tables": [],
            "vectors": []
          }
        },
        "name": {
          "description": "Stable application component name.",
          "type": "string"
        },
        "port": {
          "description": "Private HTTP port exposed to the local preview proxy.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "project": {
          "description": "Relative directory containing the full-stack Interface project.",
          "type": "string"
        },
        "version": {
          "description": "Independent source version pinned by the containing Vessel release.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "project",
        "port"
      ]
    },
    "ReadGrant": {
      "description": "Read permission for one resource.",
      "type": "object",
      "properties": {
        "read": {
          "description": "Fully qualified resource name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "read"
      ]
    },
    "TableTrigger": {
      "description": "Lakehouse table-change trigger configuration.",
      "type": "object",
      "properties": {
        "table": {
          "description": "Fully qualified table name to observe.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "table"
      ]
    },
    "WebhookTrigger": {
      "description": "Webhook trigger configuration.",
      "type": "object",
      "properties": {
        "webhook": {
          "description": "Absolute path exposed through authenticated Vessel ingress.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "webhook"
      ]
    },
    "WorkerComponent": {
      "description": "One independently versioned Worker definition materialized as Jobs.",
      "type": "object",
      "properties": {
        "grants": {
          "description": "Lakehouse and Integration capabilities granted to each derived Job.",
          "$ref": "#/$defs/ComponentGrants",
          "default": {
            "graphs": [],
            "integrations": [],
            "tables": [],
            "vectors": []
          }
        },
        "name": {
          "description": "Stable Worker definition name.",
          "type": "string"
        },
        "project": {
          "description": "Relative directory containing the Worker project.",
          "type": "string"
        },
        "triggers": {
          "description": "Events that create Jobs from this Worker definition; empty means manual only.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkerTrigger"
          }
        },
        "version": {
          "description": "Independent source version pinned by the containing Vessel release.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "project"
      ]
    },
    "WorkerTrigger": {
      "description": "A single source of Jobs for a Worker definition.",
      "anyOf": [
        {
          "description": "Subscribe to one CloudEvents type.",
          "$ref": "#/$defs/EventTrigger"
        },
        {
          "description": "Run from a cron expression.",
          "$ref": "#/$defs/CronTrigger"
        },
        {
          "description": "Run when a lakehouse table changes.",
          "$ref": "#/$defs/TableTrigger"
        },
        {
          "description": "Accept a webhook on an absolute path.",
          "$ref": "#/$defs/WebhookTrigger"
        }
      ]
    },
    "WriteGrant": {
      "description": "Write permission for one resource.",
      "type": "object",
      "properties": {
        "write": {
          "description": "Fully qualified resource name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "write"
      ]
    }
  }
}
