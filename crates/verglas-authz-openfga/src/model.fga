model
  schema 1.1

type principal

type resource
  relations
    define parent: [resource]
    define discover: [principal] or discover from parent
    define describe: [principal] or describe from parent
    define query: [principal] or query from parent
    define append: [principal] or append from parent
    define modify: [principal] or modify from parent
    define create_child: [principal] or create_child from parent
    define execute: [principal] or execute from parent
    define use_secret: [principal] or use_secret from parent
    define deploy: [principal] or deploy from parent
    define pass_grants: [principal] or pass_grants from parent
    define manage_grants: [principal] or manage_grants from parent
    define own: [principal] or own from parent
