# Builds the catalog binary from this tree. Separate from the engine Dockerfile
# because it builds a different package; it shares the CACHE_NS namespacing so
# two source trees never satisfy each other's imports from one cargo cache.
FROM rust:bookworm AS build
ARG CACHE_NS=default
WORKDIR /src
COPY rust-toolchain.toml ./
RUN rustup show
RUN apt-get update && apt-get install -y --no-install-recommends cmake libclang-dev pkg-config && rm -rf /var/lib/apt/lists/*
COPY . .
RUN --mount=type=cache,id=verglas-cargo-registry-${CACHE_NS},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=verglas-cargo-git-${CACHE_NS},target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=verglas-lakekeeper-target-${CACHE_NS},target=/src/target,sharing=locked \
    cargo build --release -p lakekeeper-bin \
    && mkdir -p /tmp/out && cp /src/target/release/lakekeeper /tmp/out/

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /tmp/out/lakekeeper /usr/local/bin/lakekeeper
ENTRYPOINT ["lakekeeper"]
