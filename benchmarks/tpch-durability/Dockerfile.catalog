# Build the repository's consolidated CRaft Lakekeeper binary, never upstream Lakekeeper+PostgreSQL.
FROM rust:1.96.1-bookworm AS build
WORKDIR /src
COPY . .
WORKDIR /src/crates/verglas-catalog-service
# Cargo discovers the vendored workspace's `.cargo/config.toml` from this
# directory. That config enables the tracing cfg required by Lakekeeper's
# structured `valuable` fields.
RUN cargo build --release -p lakekeeper-bin

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/crates/verglas-catalog-service/target/release/lakekeeper /usr/local/bin/lakekeeper
USER 65534:65534
EXPOSE 8181
ENTRYPOINT ["lakekeeper"]
