# Pinned polaris-tools checkout (cloned by run.sh; venv-style, never committed).
polaris-tools/

# Persistent Gradle cache used by the dockerized Gatling runner.
.gradle-cache/

# Generated per-leg Gatling config (carries the leg's storage endpoint + keys).
application.conf
application-*.conf

# Per-leg results, merged comparison output, and raw Gatling reports. Published
# numbers go on the issue, not into the tree (benchmarks/ convention).
results/

# Full run transcripts (nohup output).
*.out

# Server logs captured while parsing the dev-key banner.
*.log

# Python bytecode from the stdlib report script.
__pycache__/
*.pyc

# OCI origin credentials — copied in, never committed (guarded in run.sh too).
.env
