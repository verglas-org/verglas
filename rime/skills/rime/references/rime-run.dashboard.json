{
  "spec_version": 1,
  "name": "rime-run",
  "title": "RIME run tree",
  "sources": {
    "tree": {
      "type": "graph",
      "graph": "rime_PROJECT",
      "view": "k-hop",
      "from": "run:ROOT",
      "hops": 3
    },
    "nodes": { "type": "table", "table": "rime_PROJECT.nodes", "follow": true },
    "edges": { "type": "table", "table": "rime_PROJECT.edges", "follow": true }
  },
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": { "direction": "vertical", "gap": "md" },
      "children": ["summary", "graph", "detail"]
    },
    "summary": {
      "type": "Card",
      "props": { "title": "Run" },
      "children": ["candidates", "evidence"]
    },
    "candidates": {
      "type": "Metric",
      "props": { "source": "nodes", "label": "candidates", "filter": { "labels": "rime-candidate" } },
      "children": []
    },
    "evidence": {
      "type": "Metric",
      "props": { "source": "edges", "label": "evidence edges", "filter": { "predicate": "evidenced_by" } },
      "children": []
    },
    "graph": {
      "type": "GraphView",
      "props": { "source": "tree" },
      "children": []
    },
    "detail": {
      "type": "Table",
      "props": { "source": "edges" },
      "children": []
    }
  }
}
