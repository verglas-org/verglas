      "props": { "tabs": ["Live log", "Isolated slices", "Proof chain"] },
      "children": ["stream", "slice-table", "proof-graph"]
    },
    "stream": {
      "type": "LogStream",
      "props": { "source": "raw" },
      "children": []
    },
    "slice-table": {
      "type": "Table",
      "props": { "source": "slices" },
      "children": []
    },
    "proof-graph": {
      "type": "GraphView",
      "props": { "source": "proof" },
      "children": []
