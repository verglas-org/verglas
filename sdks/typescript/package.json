{
  "name": "@verglas/sdk",
  "version": "0.1.1",
  "private": false,
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verglas-org/verglas.git",
    "directory": "sdks/typescript"
  },
  "type": "module",
  "description": "Dependency-free TypeScript SDK for Verglas catalog, cache, and semantic clients. Runs in fetch-capable runtimes and Node 18+.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "default": "./dist/logging.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup --entry.index src/index.ts --entry.data src/data.ts --entry.logging src/logging.ts --format esm --dts --out-dir dist --clean",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
