{
  "name": "@verglas/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Thin TypeScript client that agent-generated worker code imports to read and write Verglas Iceberg tables. Runs in any fetch-capable runtime and in Node 18+.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logging": "./src/logging.ts",
    "./trajectory": "./src/trajectory.ts",
    "./examples": "./src/examples/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@letta-ai/trajectory": "0.2.0",
    "apache-arrow": "^21.2.0"
  }
}
